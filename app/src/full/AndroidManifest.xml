<?xml version="1.0" encoding="utf-8"?>
<!--
  flavor `full` (GitHub Releases, прямая установка).
  Полный доступ к файлам нужен, чтобы сканировать обычные пути и отдавать читалкам file://,
  а также чтобы видеть все установленные читалки. Наличие CBR задаётся BuildConfig.ENABLE_CBR.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- «Доступ ко всем файлам»: MANAGE_EXTERNAL_STORAGE + Declaration Form при публикации -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Расширенный поиск читалок: нужен для диалога «Открыть в…» -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

</manifest>
