<?xml version="1.0" encoding="utf-8"?>
<!--
  Заглушки для инструментальных тестов. Только debug-сборка: в release их нет.

  * DebugDocumentsProvider — отвечает на URI и колонки DocumentsContract, чтобы проверить
    обход SAF. Не DocumentsProvider: Android разрешает приложению держать настоящий
    DocumentsProvider только с системной подписью (MANAGE_DOCUMENTS).
  * DebugReaderActivity — «читалка», которая ловит ACTION_VIEW с книжным MIME и запоминает
    намерение, чтобы тест проверил, что книга уходит наружу с нужным URI и типом.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          Провайдер обязан быть экспортируемым: инструментальный тест живёт в отдельном APK и
          обращается к заглушке через ContentResolver, а не изнутри процесса приложения. Данные в
          заглушке тестовые (URI и колонки DocumentsContract), но lint справедливо предупреждает, что
          через экспортируемый провайдер вообще можно отдать чужие данные, поэтому предупреждение
          гасится осознанно — так же, как `AppLinkUrlError` ниже. В release-сборке этого провайдера
          нет: файл лежит в `src/debug`.
        -->
        <provider
            android:name="io.github.bookshelf.debug.DebugDocumentsProvider"
            android:authorities="${applicationId}.debug.saf"
            android:exported="true"
            android:grantUriPermissions="true"
            tools:ignore="ExportedContentProvider" />

        <activity
            android:name="io.github.bookshelf.debug.DebugReaderActivity"
            android:exported="true">
            <!--
              Ловим VIEW по MIME, а не по ссылке: это заглушка читалки для инструментальных тестов.
              Lint принимает такой фильтр за deep link и требует URL — требование здесь неприменимо,
              поэтому ошибка `AppLinkUrlError` гасится осознанно (иначе падает шаг `lintFullDebug`
              в CI, проверено 02.10.2026).
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/fb2" />
            </intent-filter>
        </activity>
    </application>

</manifest>
