<?xml version="1.0" encoding="utf-8"?>
<!--
  Что система имеет право выносить из приложения (Android 12+).

  Приложение хранит библиотеку у пользователя в его папке (`Books`) и свою резервную копию кладёт
  рядом (`/sdcard/Books/.bookshelf`, ADR — фича «Бэкап»), поэтому системная копия данных не нужна:
  она бы дублировала книги в облако и на новое устройство.

  Почему мало `android:allowBackup="false"` в манифесте: этот атрибут остаётся для Android 11 и
  ниже, а на Android 12+ передача на новое устройство **не** подчиняется ему — без этого файла
  система могла бы перенести данные приложения на другое устройство. Правила ниже закрывают и
  облачную копию, и передачу. Проверено правилом `DataExtractionRules` в lint.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
