<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Разрешения разделены по flavor-измерению `store`:
      * main — то, что нужно всем сборкам;
      * src/full, src/fdroid — доступ ко всем файлам и широкий список приложений;
      * src/play — только SAF и <queries> (политики Google Play, ADR-007).
    -->

    <!--
        Открытый HTTP разрешён осознанно: `targetSdk 35` запрещает cleartext по умолчанию, а
        каталоги OPDS в большинстве случаев живут без TLS. Без этого «Проверить и добавить»
        на http-ссылке падал с `CLEARTEXT communication ... not permitted`, и ловился
        пользователем как «ссылка не открывается».

        Чем это оплачивается: у таких фидов нет ни шифрования, ни проверки целостности ответа.
        Для анонимного каталога с книгами это приемлемо, но пароль от каталога по http уходить
        не должен — вкладку с авторизацией для таких адресов закрывать.
    -->

    <!-- OPDS — единственный сценарий с сетью. Аналитики и крашлитики в приложении нет. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- API 24–32: доступ к файлам по старым правилам (для flavor full/fdroid) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Долгий скан обязан быть foreground-сервисом, иначе система убьёт процесс -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Список читалок ищется через queryIntentActivities. Вместо QUERY_ALL_PACKAGES
      (Google Play: «most apps are not allowed») объявляем только то, что реально нужно.
    -->
    <queries>
        <!--
            FBReader — целевая читалка проекта (ADR-005). Пакет объявлен явно: на Android 11+
            читалка не видна без `<queries>`, и кнопка «Читать» уходила в посторонние
            приложения, объявившие те же книжные MIME-типы (проверено на устройстве 2026-09-25:
            вместо FBReader открывался AniLabX). Значение `com.fbreader` подтверждено
            `dumpsys package`; `org.geometerplus.zlibrary.ui.android` — старый FBReader for Android.
        -->
        <package android:name="com.fbreader" />
        <package android:name="org.geometerplus.zlibrary.ui.android" />
        <!-- Остальные поддерживаемые читалки: без `<queries>` они на Android 11+ не видны,
             даже если установлены и объявили нужные MIME-типы. Список — в FbReaderPreset. -->
        <package android:name="org.coolreader" />
        <package android:name="org.koreader.launcher" />
        <package android:name="org.koreader.launcher.fdroid" />
        <package android:name="com.foobnix.pdf.reader" />
        <package android:name="com.neverland.alreader" />

        <intent>
            <action android:name="android.fbreader.action.VIEW" />
        </intent>
        <intent>
            <action android:name="android.fbreader.action.API" />
        </intent>
        <intent>
            <action android:name="android.fbreader.action.LIBRARY_SERVICE" />
        </intent>

        <!--
            Читалки объявляют фильтры со схемой `content`/`file`, поэтому запрос тоже должен
            нести схему: без неё фильтр с `StaticType` не совпадает и пакет остаётся скрытым.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" android:mimeType="application/octet-stream" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" android:mimeType="application/epub+zip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="file" android:mimeType="application/octet-stream" />
        </intent>

        <intent>
            <action android:name="android.fbreader.action.VIEW" />
        </intent>
        <intent>
            <action android:name="android.fbreader.action.API" />
        </intent>
        <intent>
            <action android:name="android.fbreader.action.LIBRARY_SERVICE" />
        </intent>

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/epub+zip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/x-mobipocket-ebook" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/octet-stream" />
        </intent>
        <!--
            Форматы, которые приложение открывает, но которые раньше не были объявлены здесь.
            Без них на Android 11+ система скрывает подходящие читалки целиком (package
            visibility), и «открыть в читалке» не находит ничего.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/rtf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.comicbook+zip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.comicbook-rar" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.oasis.opendocument.text" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data
                android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        </intent>
    </queries>

    <application
        android:name=".BookShelfApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookShelf"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BookShelf.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Отдаём книги читалкам, которые не понимают content:// от SAF (ADR-004) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager инициализируется вручную (HiltWorkerFactory), поэтому стандартный
          инициализатор через androidx.startup убираем — иначе фабрика не применится.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Долгий скан: тип dataSync обязателен на Android 14+, лимит 6 ч/24 ч на Android 15 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
